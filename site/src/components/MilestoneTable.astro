---
// MilestoneTable.astro — spec 003, FR-008: milestone status from src/data/milestones.yaml
import yaml from 'js-yaml';
import raw from '../data/milestones.yaml?raw';

type Milestone = { id: string; title: string; scope: string; status: 'done' | 'in-progress' | 'planned'; proposed?: boolean };
const milestones = yaml.load(raw) as Milestone[];
const label = { done: 'Done', 'in-progress': 'In progress', planned: 'Planned' };
---
<ol class="milestones not-content">
  {milestones.map((m) => (
    <li class={`ms ms--${m.status}`}>
      <span class="ms__id">{m.id}</span>
      <span class="ms__text">
        <strong>{m.title}</strong>{m.proposed && <em class="ms__proposed"> (proposed)</em>}
        <span class="ms__scope">{m.scope}</span>
      </span>
      <span class="ms__status">{label[m.status]}</span>
    </li>
  ))}
</ol>

<style>
  .milestones { list-style: none; padding: 0; margin: 1rem 0; display: grid; gap: 0.5rem; }
  .ms {
    display: grid; grid-template-columns: 3rem 1fr auto; gap: 0.75rem; align-items: center;
    padding: 0.6rem 0.8rem; border: 1px solid var(--sl-color-gray-5); border-radius: 0.5rem;
    background: var(--sl-color-bg-nav);
  }
  .ms__id { font-family: var(--sl-font-mono); font-weight: 700; color: var(--sl-color-accent-high); }
  .ms__text { display: flex; flex-direction: column; min-width: 0; }
  .ms__scope { font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); }
  .ms__proposed { font-weight: 400; color: var(--sl-color-gray-3); }
  .ms__status {
    font-size: var(--sl-text-xs); padding: 0.15rem 0.55rem; border-radius: 999px; white-space: nowrap;
    border: 1px solid var(--sl-color-gray-5); color: var(--sl-color-gray-3);
  }
  .ms--in-progress { border-color: var(--sl-color-accent); }
  .ms--in-progress .ms__status { background: var(--sl-color-accent); border-color: var(--sl-color-accent); color: var(--sl-color-black); }
  .ms--done .ms__status { background: var(--sl-color-green-low); border-color: var(--sl-color-green); color: var(--sl-color-green-high); }
  @media (max-width: 30rem) {
    .ms { grid-template-columns: 2.5rem 1fr; }
    .ms__status { grid-column: 2; justify-self: start; }
  }
</style>
